import java.util.*;
class CommonPrefix {
    public static void main(String[] args) {
       char[] a="DheeLab".toCharArray();
       char[] b="DheeCodingLab".toCharArray();
       int n=Math.min(a.length,b.length);
       for(int i=0;i<=n-1;i++){
           if(a[i]==b[i]){
               System.out.print(a[i]);
           }
           else{
               break;
           }
       }
    }
}
